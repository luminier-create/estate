# ─────────────────────────────────────────────────────────────
# Firebase 웹 SDK (공개 — 클라이언트 번들에 포함됨)
# Firebase Console > 프로젝트 설정 > 내 앱 > 웹 앱 구성
# App Hosting 은 백엔드에 연결된 웹 앱 값을 빌드 때 자동으로 넣는다 (next.config.ts).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# 인증 모드 — 비우면 자동 판정 (Firebase 값이 없으면 데모). 판정: src/lib/firebase/auth-mode.ts
# firebase 로 두면 데모 로그인이 닫히고, NEXT_PUBLIC_FIREBASE_* 가 비어 있으면 빌드가 멈춘다.
# App Hosting 은 apphosting.yaml 이 firebase 로 고정한다.
# ─────────────────────────────────────────────────────────────
HOMEFIT_AUTH_MODE=

# ─────────────────────────────────────────────────────────────
# Firebase Admin SDK (서버 전용 — 절대 클라이언트 노출 금지)
# 로컬·Vercel 전용. Firebase App Hosting 은 키 없이 런타임 서비스 계정(ADC)으로 붙는다.
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# PRIVATE_KEY 는 개행을 \n 으로 이스케이프하여 한 줄로 입력
# ─────────────────────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# 카카오 지도 JS SDK (공개 — 반드시 플랫폼 도메인 제한 설정)
# developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_KAKAO_JS_KEY=

# ─────────────────────────────────────────────────────────────
# 외부 데이터 API (서버 전용)
# 미설정 시 해당 Provider 는 Mock 구현으로 자동 폴백한다.
# 발급 절차: docs/03-DATA-SOURCES.md §8
# ─────────────────────────────────────────────────────────────
KAKAO_REST_API_KEY=
ODSAY_API_KEY=
APT_MGMT_API_KEY=

# 국토부 아파트 매매 실거래가 — data.go.kr 의 "일반 인증키"를 그대로 넣는다.
# Encoding/Decoding 어느 쪽이든 동작한다 (normalizeServiceKey 가 맞춰준다).
# 활용신청한 서비스가 상세 자료면 MOLIT_SERVICE_NAME 도 바꾼다.
#   일반 자료(기본값): RTMSDataSvcAptTrade      www.data.go.kr/data/15126469/openapi.do
#   상세 자료:         RTMSDataSvcAptTradeDev   www.data.go.kr/data/15126468/openapi.do
# 어느 쪽이 유효한지 모르면: npm run probe:molit
MOLIT_SERVICE_KEY=
MOLIT_SERVICE_NAME=

# 한국부동산원 부동산통계정보(R-ONE) — 지역 시장 지표
# www.reb.or.kr/r-one/portal/openapi/openApiDevPage.do 에서 발급
REB_API_KEY=

# ─────────────────────────────────────────────────────────────
# 시연용 배포 (선택)
# ─────────────────────────────────────────────────────────────
# Firebase Admin 미설정 시 저장소가 프로세스 메모리라, 서버리스에 올리면
# 인스턴스마다 비어 있다. 1 로 두면 후보 3건과 그 분석을 첫 요청에 채워
# 어느 인스턴스에서든 같은 화면이 나온다. 절차는 docs/06-DEPLOY.md
DEMO_SEED=

# ─────────────────────────────────────────────────────────────
# 일일 호출 상한 (선택 — 미설정 시 기본값 사용)
# 캐시에 적중하면 소모하지 않으며, 상한 도달 시 해당 축만 결측 처리된다.
# 기본값: 카카오 30000 / 국토부 9000 / ODsay 800
# ─────────────────────────────────────────────────────────────
QUOTA_KAKAO=
QUOTA_MOLIT=
QUOTA_ODSAY=
QUOTA_REB=
