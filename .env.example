# ─────────────────────────────────────────────────────────────
# Firebase 웹 SDK (공개 — 클라이언트 번들에 포함됨)
# Firebase Console > 프로젝트 설정 > 내 앱 > 웹 앱 구성
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# Firebase Admin SDK (서버 전용 — 절대 클라이언트 노출 금지)
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# PRIVATE_KEY 는 개행을 \n 으로 이스케이프하여 한 줄로 입력
# ─────────────────────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# 카카오 지도 JS SDK (공개 — 반드시 플랫폼 도메인 제한 설정)
# developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_KAKAO_JS_KEY=

# ─────────────────────────────────────────────────────────────
# 외부 데이터 API (서버 전용)
# 미설정 시 해당 Provider 는 Mock 구현으로 자동 폴백한다.
# 발급 절차: docs/03-DATA-SOURCES.md §8
# ─────────────────────────────────────────────────────────────
KAKAO_REST_API_KEY=
MOLIT_SERVICE_KEY=
ODSAY_API_KEY=
APT_MGMT_API_KEY=
